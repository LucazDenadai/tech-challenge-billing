    "/billing/pagamentos/webhook/mercadopago": {
      "post": {
        "tags": [
          "WebhookMercadoPago"
        ],
        "summary": "Recebe a notificação de pagamento do Mercado Pago.",
        "description": "Exige os cabeçalhos `x-signature` (`ts=...,v1=...`) e `x-request-id` e o parâmetro `data.id`.\r\nO mesmo `x-request-id` reenviado não é processado de novo. Notificações de outros tipos são ignoradas.",
        "parameters": [
          {
            "name": "data.id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "in": "header",
            "schema": {
