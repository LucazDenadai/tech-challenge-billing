          "precoUnitario": {
            "type": "number",
            "format": "double"
          },
          "subtotal": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OrcamentoResponse": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "osId": {
            "type": "string",
            "format": "uuid"
          },
          "filialId": {
            "type": "string",
            "format": "uuid"
          },
          "versaoVigente": {
