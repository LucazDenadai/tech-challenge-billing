                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Aprovação registrada (ou já registrada). O evento QuoteApproved sai pela outbox.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrcamentoResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrcamentoResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrcamentoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
