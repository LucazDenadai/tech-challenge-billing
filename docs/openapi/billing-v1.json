{
  "openapi": "3.0.1",
  "info": {
    "title": "Oficina Mecânica — Billing API",
    "description": "Serviço Billing da Fase 4: orçamento da OS e decisão do cliente. O orçamento nasce do comando QuoteRequested da Saga (AsyncAPI); a aprovação e a recusa são só do cliente dono da OS, com o JWT emitido pela Lambda de CPF. Pagamento e Mercado Pago entram no CARD-39b.",
    "version": "v1"
  },
  "paths": {
