          },
          "versoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersaoOrcamentoResponse"
            },
            "nullable": true
          },
          "decisoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DecisaoOrcamentoResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "RecusarOrcamentoRequest": {
        "type": "object",
        "properties": {
          "versao": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Versão apresentada ao cliente.",
            "format": "int32"
          },
          "motivo": {
            "maxLength": 500,
            "type": "string",
            "description": "Motivo opcional da recusa.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResultadoDecisao": {
        "enum": [
          "Aprovado",
          "Recusado"
        ],
        "type": "string"
      },
      "StatusVersaoOrcamento": {
        "enum": [
          "AguardandoDecisao",
          "Aprovada",
          "Recusada",
          "Expirada",
          "Substituida"
        ],
        "type": "string"
      },
      "TipoItemOrcamento": {
        "enum": [
          "Peca",
          "Servico"
        ],
        "type": "string"
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "VersaoOrcamentoResponse": {
        "type": "object",
        "properties": {
          "versao": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/StatusVersaoOrcamento"
          },
          "valorTotal": {
            "type": "number",
            "format": "double"
          },
          "moeda": {
            "type": "string",
            "nullable": true
          },
          "precoSnapshotEm": {
            "type": "string",
            "format": "date-time"
          },
          "expiraEm": {
            "type": "string",
            "format": "date-time"
          },
          "encerradaEm": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrcamentoResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT de cliente (Lambda de CPF, POST /atendimento/auth/cpf) ou de funcionário (serviço OS, POST /os/auth/login).",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
