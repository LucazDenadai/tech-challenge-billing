  "components": {
    "schemas": {
      "AprovarOrcamentoRequest": {
        "type": "object",
        "properties": {
          "versao": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Versão apresentada ao cliente. A aprovação vale só para ela.",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DecisaoOrcamentoResponse": {
        "type": "object",
        "properties": {
          "versao": {
            "type": "integer",
            "format": "int32"
          },
          "resultado": {
            "$ref": "#/components/schemas/ResultadoDecisao"
          },
          "decididaEm": {
            "type": "string",
            "format": "date-time"
          },
          "motivo": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ItemOrcamentoResponse": {
        "type": "object",
        "properties": {
          "itemId": {
